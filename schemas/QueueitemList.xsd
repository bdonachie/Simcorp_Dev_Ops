<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="QueueItem">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="QueueId">
          <xs:simpleType>
            <xs:restriction base="xs:string"/>
          </xs:simpleType>
        </xs:element>
        <xs:element name="ActionType" type="QueueitemTypes"/>
        <xs:element name="ActionState" type="QueueitemStates"/>
        <xs:element name="Service">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Id">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="\*"/>
                    <xs:pattern value="[0-9]+"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Name" type="xs:string"/>
              <xs:element name="Instance" type="xs:string" minOccurs="0"/>
              <xs:element name="InstanceFrom" minOccurs="0"/>
              <xs:element name="InstanceTo" minOccurs="0"/>
              <xs:element name="Configuration" type="DatabaseElementType"/>
              <xs:element name="Nickname" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Agent" type="xs:string" minOccurs="0"/>
        <xs:element name="AgentFrom" minOccurs="0"/>
        <xs:element name="AgentTo" type="xs:string" minOccurs="0"/>
        <xs:element name="ManagementMode" type="ControllerManagementModes"/>
        <xs:element name="Elastic" type="ElasticTypes" minOccurs="0"/>
        <xs:element name="QueuedAt" type="xs:dateTime"/>
        <xs:element name="RequestedAt" type="xs:dateTime"/>
        <xs:element name="Source" type="SourceTypes"/>
        <xs:element name="Tag" type="xs:string"/>
        <xs:element name="Reason" type="QueueItemReasons"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="QueueitemList">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Version history:
        2201: Added Source
        1904: Added Reason ServiceIsStarted for stopping a service in a move operation. Added Reason NotEnoughAvailableResources for missing resources when starting elastic services. Added Elastic to start queue info
        1901: Added Move. Added Transitional management mode
        63: QueueItemReasons uddated with new value: ServiceTypeBlacklisted, UnableToAssignServiceInstanceId and ServiceFaultedWithNewStartAttempt
        62: Added Nickname and changed ServiceType, Configuration, ManagementMode and Nickname to be able to contain '*' when not specified.
        61: Added more QueueItemReasons. Added Infrastructure controller management mode. Removed ParameterSet usage.
        60: Updates for SCD version 6.0. Added minorVersion to support patching.
        1: Initial version.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice>
        <xs:element name="UnexpectedError" type="xs:string"/>
        <xs:sequence>
          <xs:element name="ServiceSegment" type="xs:string" minOccurs="0"/>
          <xs:element name="DirectoryServices" type="xs:string" minOccurs="0"/>
          <xs:element ref="QueueItems"/>
          <xs:element name="Warnings" type="Warnings" minOccurs="0"/>
        </xs:sequence>
      </xs:choice>
      <xs:attribute name="Version" type="xs:positiveInteger" use="required" fixed="2201"/>
      <xs:attribute name="MinorVersion" type="xs:nonNegativeInteger" use="required" fixed="0"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="QueueItems">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="QueueItem" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="DatabaseElementType">
    <xs:sequence>
      <xs:element name="Id" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="\*"/>
            <xs:pattern value="[0-9]+"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Name" type="xs:string" minOccurs="0"/>
      <xs:element name="Description" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="ControllerManagementModes">
    <xs:restriction base="xs:string">
      <xs:enumeration value="*"/>
      <xs:enumeration value="Manual"/>
      <xs:enumeration value="Automated"/>
      <xs:enumeration value="Infrastructure"/>
      <xs:enumeration value="Transitional"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ElasticTypes">
    <xs:restriction base="xs:string">
      <xs:enumeration value=""/>
      <xs:enumeration value="No"/>
      <xs:enumeration value="Yes"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SourceTypes">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Unknown"/>
      <xs:enumeration value="ServiceManager"/>
      <xs:enumeration value="ServiceControlUtility"/>
      <xs:enumeration value="DependencyStrategy"/>
      <xs:enumeration value="InfrastructureStrategy"/>
      <xs:enumeration value="DependencyScaling"/>
      <xs:enumeration value="Rebalancing"/>
      <xs:enumeration value="AutomationService"/>
      <xs:enumeration value="LicenseChecker"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="QueueitemStates">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Waiting"/>
      <xs:enumeration value="Processing"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="QueueitemTypes">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Start"/>
      <xs:enumeration value="Stop"/>
      <xs:enumeration value="Move"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="QueueItemReasons">
    <xs:restriction base="xs:string">
      <xs:enumeration value="RequestAddedToQueue"/>
      <xs:enumeration value="NoLicenseAvailable"/>
      <xs:enumeration value="NoControllerFound"/>
      <xs:enumeration value="ServiceIsStarting"/>
      <xs:enumeration value="ServiceIsStopping"/>
      <xs:enumeration value="ControllerBusy"/>
      <xs:enumeration value="MaxRunningReached"/>
      <xs:enumeration value="MaxRunningReachedCapabilities"/>
      <xs:enumeration value="MaxRunningReachedTagged"/>
      <xs:enumeration value="NoControllerFoundTagged"/>
      <xs:enumeration value="NoControllerFoundCapability"/>
      <xs:enumeration value="ServiceTypeBlocked"/>
      <xs:enumeration value="ServiceTypeBlacklisted"/>
      <xs:enumeration value="UnableToAssignServiceInstanceId"/>
      <xs:enumeration value="ServiceFaultedWithNewStartAttempt"/>
      <xs:enumeration value="ServiceIsStarted"/>
      <xs:enumeration value="NotEnoughAvailableResources"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Log">
    <xs:sequence>
      <xs:element name="Severity">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="Error"/>
            <xs:enumeration value="Fatal"/>
            <xs:enumeration value="Info"/>
            <xs:enumeration value="Start"/>
            <xs:enumeration value="Status"/>
            <xs:enumeration value="StatusNonPersistent"/>
            <xs:enumeration value="Stop"/>
            <xs:enumeration value="Warning"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Message" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Warnings">
    <xs:sequence>
      <xs:element name="Logs" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Log" type="Log" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Validations" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Message" type="xs:string" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
