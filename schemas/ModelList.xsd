<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="ModelState">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Active"/>
      <xs:enumeration value="Passive"/>
      <xs:enumeration value="NotAuthorized"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="Model">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="State" type="ModelState"/>
        <xs:element name="Description" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Models">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Model" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ModelList">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Version history:
        62: Updates for SCD version 6.2. Added Error element
        60: Updates for SCD version 6.0. Added minorVersion to support patching.
        1: Initial version.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ServiceSegment" type="xs:string" minOccurs="0"/>
        <xs:element name="DirectoryServices" type="xs:string" minOccurs="0"/>
        <xs:choice>
          <xs:element name="Error" type="xs:string"/>
          <xs:element name="UnexpectedError" type="xs:string"/>
          <xs:sequence>
            <xs:element ref="Models"/>
            <xs:element name="Warnings" type="Warnings" minOccurs="0"/>
          </xs:sequence>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="Version" type="xs:positiveInteger" use="required" fixed="62"/>
      <xs:attribute name="MinorVersion" type="xs:nonNegativeInteger" use="required" fixed="0"/>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="Log">
    <xs:sequence>
      <xs:element name="Severity">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="Error"/>
            <xs:enumeration value="Fatal"/>
            <xs:enumeration value="Info"/>
            <xs:enumeration value="Start"/>
            <xs:enumeration value="Status"/>
            <xs:enumeration value="StatusNonPersistent"/>
            <xs:enumeration value="Stop"/>
            <xs:enumeration value="Warning"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Message" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Warnings">
    <xs:sequence>
      <xs:element name="Logs" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Log" type="Log" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Validations" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Message" type="xs:string" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
