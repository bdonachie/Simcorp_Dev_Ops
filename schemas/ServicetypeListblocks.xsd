<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="ServicetypeListblocks">
    <xs:annotation>
      <xs:documentation xml:lang="en">
        Version history:
        61: Initial version.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice>
        <xs:element name="UnexpectedError" type="xs:string"/>
        <xs:sequence>
          <xs:element name="ServiceSegment" type="xs:string" minOccurs="0"/>
          <xs:element name="DirectoryServices" type="xs:string" minOccurs="0"/>
          <xs:element ref="Services"/>
          <xs:element name="Warnings" type="Warnings" minOccurs="0"/>
        </xs:sequence>
      </xs:choice>
      <xs:attribute name="Version" type="xs:positiveInteger" use="required" fixed="61"/>
      <xs:attribute name="MinorVersion" type="xs:nonNegativeInteger" use="required" fixed="0"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Service">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Id" type="xs:nonNegativeInteger"/>
        <xs:element name="Type" type="xs:string"/>
        <xs:element name="Configuration">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Name" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="\(All\)"/>
                    <xs:pattern value="Unavailable"/>
                    <xs:pattern value="[a-zA-Z0-9 _-]+"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Reason" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Services">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Service" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="Warnings">
    <xs:sequence>
      <xs:element name="Validations" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Message" type="xs:string" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>