<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore from nuget.org only, whatever the machine's own NuGet configuration says,
       so a fresh clone builds the same way everywhere, CI included. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
